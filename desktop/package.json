{
  "name": "camai-desktop",
  "version": "1.0.0",
  "description": "CamAI Desktop — Enterprise AI CCTV client for Windows",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.node.json && vite build && electron-builder --win",
    "start": "tsc -p tsconfig.node.json && vite build && electron ."
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "systeminformation": "^5.22.11"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "clsx": "^2.1.1",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "lucide-react": "^0.395.0",
    "postcss": "^8.4.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.4.5",
    "vite": "^5.3.1",
    "vite-plugin-electron": "^0.28.7"
  },
  "build": {
    "appId": "ai.camai.desktop",
    "productName": "CamAI Desktop",
    "win": {
      "target": "nsis",
      "artifactName": "CamAI-Desktop-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "files": ["dist/**", "dist-electron/**"],
    "publish": null
  }
}
