# CamAI AWS Real-Time Cloud Node Environment Template
# =====================================================
# Copy this file to .env and fill in the actual values.
# NEVER commit .env with real secrets to Git.

# === AWS Server Configuration ===
CAMAI_HOST=0.0.0.0
CAMAI_PORT=8099

# === AI Model Configuration ===
# Options: yolox_tiny | yolox_s | yolox_m
CAMAI_MODEL_NAME=yolox_tiny
CAMAI_CONF_THRESH=0.40

# === Axis Camera RTSP Stream URL (for direct RTSP ingestion on the server) ===
# Format: rtsp://user:password@<camera-ip>/axis-media/media.amp?videocodec=h264
CAMAI_CAMERA_RTSP_URL=

# === AWS Credentials (use IAM roles on EC2 instead of hardcoding) ===
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-south-1

# === Optional Auth Token ===
# CAMAI_API_TOKEN=

# === Logging ===
LOG_LEVEL=INFO
