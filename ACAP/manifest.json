{
  "schemaVersion": "1.3",
  "acapPackageConf": {
    "setup": {
      "friendlyName": "CamAI Edge",
      "appName": "camai_acap",
      "execName": "camai_acap",
      "vendor": "CamAI Enterprise",
      "vendorId": "1234567890",
      "version": "1.0.0",
      "architecture": "armv7hf",
      "runMode": "respawn",
      "embeddedSdkVersion": "3.0"
    },
    "configuration": {
      "setting": [
        {
          "name": "EnableSecurityModule",
          "type": "bool",
          "default": "true"
        },
        {
          "name": "ConfidenceThreshold",
          "type": "string",
          "default": "0.45"
        },
        {
          "name": "EnableOverlay",
          "type": "bool",
          "default": "true"
        },
        {
          "name": "MaxProcessingFPS",
          "type": "int",
          "default": "15"
        }
      ]
    }
  }
}
